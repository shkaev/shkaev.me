---
import BackLink from "../BackLink.astro";
import PageLead from "../typography/PageLead.astro";
import PageTitle from "../typography/PageTitle.astro";
import { getPerfumeCollection } from "../../design/playground/perfume-collection";
import type { Locale } from "../../i18n/config";
import { localizePath } from "../../i18n/routing";
import { resolveStaticAssetUrl } from "../../lib/assetUrl";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const collection = getPerfumeCollection(locale);
const backHref = localizePath("/design", locale);
const resolveImage = (file: string) =>
	resolveStaticAssetUrl(`/images/playground/perfume-collection/${file}`);
---

<div class="perfume-collection flex w-full flex-col">
	<div class="w-full max-w-content">
		<section class="w-full">
			<BackLink href={backHref} label={collection.eyebrow} />
			<PageTitle class="mt-6">{collection.title}</PageTitle>
			<PageLead class="mt-5">{collection.lead}</PageLead>
		</section>
	</div>

	<section class="mt-8 w-full" aria-label={collection.sectionAriaLabel}>
		<div class="collection-stack">
			{
				collection.groups.map((group, groupIndex) => (
					<Fragment>
						{group.label && <div class="list-divider">{group.label}</div>}
						<div class:list={["collection-list", group.tfw && "tfw"]}>
							{group.items.map((item, itemIndex) => (
								<article class="list-row collection-grid">
									<button
										class="image-link item-image"
										type="button"
										aria-label={`${collection.openImageLabel} ${item.alt}`}
									>
										<img
											class="perfume-image"
											src={resolveImage(item.image)}
											alt={item.alt}
											loading={groupIndex === 0 && itemIndex === 0 ? undefined : "lazy"}
										/>
									</button>
									<div class="item-name">
										<a class="perfume-name" href={item.href} target="_blank" rel="noreferrer">
											{item.name}
										</a>
										<span class="subline">{item.brand}</span>
									</div>
									<div class="item-volume volume">
										{item.volume}
										<span class="concentration">{item.concentration}</span>
									</div>
									<div class="item-character cell-muted">
										{item.notes.map((line, lineIndex) => (
											<Fragment>
												{lineIndex > 0 && <br />}
												{line}
											</Fragment>
										))}
									</div>
								</article>
							))}
						</div>
					</Fragment>
				))
			}
		</div>
	</section>
</div>

<dialog class="image-viewer" data-image-viewer aria-label={collection.viewerAriaLabel}>
	<img class="image-viewer__image" data-viewer-image alt="" />
</dialog>

<style>
	.perfume-collection {
		font-size: 15px;
		line-height: 1.55;
		--pc-line-strong: #d6d3d1;
	}

	:global(html.dark) .perfume-collection {
		--pc-line-strong: #57534e;
	}

	.collection-stack {
		display: grid;
		gap: 8px;
	}

	.collection-list {
		overflow: hidden;
		border: 1px solid var(--color-line);
		border-radius: 16px;
		background: var(--color-surface-raised);
		box-shadow: var(--shadow-hairline);
	}

	.list-row {
		display: grid;
		gap: 18px;
		align-items: center;
		min-height: 104px;
		padding: 16px;
		border-bottom: 1px solid var(--color-line);
	}

	.list-row:last-child {
		border-bottom: 0;
	}

	.list-divider {
		display: flex;
		align-items: center;
		gap: 14px;
		padding-inline: 10px;
		color: color-mix(in srgb, var(--color-ink-subtle) 55%, transparent);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.list-divider::before,
	.list-divider::after {
		content: "";
		flex: 1;
		height: 1px;
		background-image: repeating-linear-gradient(
			to right,
			var(--pc-line-strong) 0 4px,
			transparent 4px 12px
		);
	}

	.collection-grid {
		grid-template-columns: 72px minmax(420px, 1.2fr) 76px minmax(260px, 1fr);
	}

	.image-link {
		display: flex;
		width: 64px;
		height: 72px;
		padding: 0;
		cursor: zoom-in;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		appearance: none;
		border: 1px solid var(--color-line);
		border-radius: 12px;
		background: #ffffff;
		transition: border-color 150ms ease, transform 150ms ease;
	}

	.image-link:hover {
		border-color: var(--pc-line-strong);
		transform: translateY(-1px);
	}

	.image-link:focus-visible {
		outline: 2px solid var(--color-ink-subtle);
		outline-offset: 3px;
	}

	.perfume-image {
		display: block;
		width: 100%;
		height: 100%;
		padding: 6px;
		object-fit: contain;
	}

	.tfw .perfume-image {
		padding: 0;
		object-fit: cover;
	}

	.image-viewer {
		position: fixed;
		inset: 0;
		width: 100vw;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: clamp(20px, 4vw, 48px);
		border: 0;
		outline: 0;
		background: transparent;
	}

	.image-viewer[open] {
		display: grid;
		place-items: center;
	}

	.image-viewer::backdrop {
		background: rgba(12, 10, 9, 0.78);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
	}

	.image-viewer__image {
		display: block;
		max-width: min(90vw, 900px);
		max-height: calc(100dvh - clamp(40px, 8vw, 96px));
		border-radius: 12px;
		background: #ffffff;
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.34);
		cursor: zoom-out;
		object-fit: contain;
	}

	:global(html.viewer-open) {
		overflow: hidden;
	}

	.perfume-name {
		display: block;
		color: var(--color-ink);
		font-family: "IBM Plex Serif", Georgia, serif;
		font-size: 18px;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.015em;
		overflow-wrap: anywhere;
	}

	a.perfume-name {
		display: inline;
		text-decoration: none;
		box-shadow: inset 0 -1px 0 var(--pc-line-strong);
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
		transition: box-shadow 150ms ease;
	}

	a.perfume-name:hover {
		box-shadow: inset 0 -1px 0 var(--color-ink);
	}

	a.perfume-name:focus-visible {
		outline: 2px solid var(--color-ink-subtle);
		outline-offset: 3px;
	}

	.subline {
		display: block;
		margin-top: 6px;
		color: var(--color-ink-subtle);
		font-size: 12px;
		line-height: 1.35;
	}

	.cell-muted {
		color: var(--color-ink-soft);
	}

	.item-character {
		font-size: 13px;
		line-height: 1.5;
	}

	.volume {
		color: var(--color-ink-muted);
		white-space: nowrap;
	}

	.concentration {
		display: block;
		color: var(--color-ink-subtle);
		font-size: 12px;
		line-height: 1.35;
	}

	@media (max-width: 960px) {
		.collection-grid {
			grid-template-columns: 58px minmax(0, 1fr) auto;
			gap: 9px 14px;
			align-items: start;
		}

		.item-image {
			grid-column: 1;
			grid-row: 1 / span 2;
		}

		.image-link {
			width: 56px;
			height: 64px;
		}

		.item-name {
			grid-column: 2;
		}

		.item-volume {
			grid-column: 3;
			grid-row: 1;
			text-align: right;
		}

		.item-character {
			grid-column: 2 / -1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.image-link,
		a.perfume-name {
			transition-duration: 0.01ms;
		}
	}
</style>

<script>
	const imageViewer = document.querySelector("[data-image-viewer]");
	const viewerImage = document.querySelector("[data-viewer-image]");

	if (imageViewer instanceof HTMLDialogElement && viewerImage instanceof HTMLImageElement) {
		document.querySelectorAll(".image-link").forEach((trigger) => {
			const thumbnail = trigger.querySelector(".perfume-image");

			if (!(thumbnail instanceof HTMLImageElement)) {
				return;
			}

			trigger.addEventListener("click", () => {
				viewerImage.src = thumbnail.currentSrc || thumbnail.src;
				viewerImage.alt = thumbnail.alt;
				document.documentElement.classList.add("viewer-open");
				imageViewer.showModal();
			});
		});

		imageViewer.addEventListener("click", (event) => {
			if (event.target === imageViewer || event.target === viewerImage) {
				imageViewer.close();
			}
		});

		imageViewer.addEventListener("close", () => {
			document.documentElement.classList.remove("viewer-open");
			viewerImage.removeAttribute("src");
			viewerImage.alt = "";
		});
	}
</script>
